# ---------------------------------------------------------------------------
# Sharia Compliance Agent — environment template
# Copy to .env and fill in. NEVER commit .env.
#
# One key runs everything: reasoning and embeddings both go through OpenRouter.
# Qdrant runs locally in Docker and needs no key.
# ---------------------------------------------------------------------------

# --- The only credential you need -----------------------------------------
OPENROUTER_API_KEY=sk-or-v1-...

# --- Reasoning model -------------------------------------------------------
# Haiku 4.5 is the default because it is the model this system was evaluated on
# and the one deployed. Whether a stronger model earns its cost is an open
# question with a ready experiment — see docs/PART2-technical-decisions.md
# §2.2.1, which argues the answer turns on escalation rate rather than price.
SCA_MODEL=anthropic/claude-haiku-4.5
SCA_MODEL_EFFORT=none              # none | low | medium | high | xhigh | max
                                   # (Haiku 4.5 predates reasoning-effort)

# CHEAP MODE — for plumbing work, not for measuring quality.
# Roughly 62% cheaper per assessment. Use it while iterating on wire formats,
# ingestion and the API; switch back before scoring an eval, because an eval run
# on one model says nothing about another.
#   SCA_MODEL=anthropic/claude-haiku-4.5
#   SCA_MODEL_EFFORT=none          # Haiku 4.5 predates reasoning-effort

# --- Embeddings ------------------------------------------------------------
# bge-m3 is multilingual with real Arabic coverage, which an English-tuned
# embedder is not. Leave SCA_EMBED_DIM at 0 to detect the width at ingest time.
SCA_EMBED_MODEL=baai/bge-m3
SCA_EMBED_DIM=0

# --- Reranking -------------------------------------------------------------
# OpenRouter has no rerank endpoint, so pick a backend:
#   llm   — a small model scores candidates. No extra setup. Demo default.
#   local — bge-reranker-v2-m3 on CPU (`pip install fastembed`). ~560MB,
#           no data egress. The production choice under CBUAE residency rules.
#   none  — fusion order only; guardrails then escalate for unverified ranking.
SCA_RERANK_BACKEND=llm
SCA_RERANK_MODEL=anthropic/claude-haiku-4.5
SCA_RERANK_LOCAL_MODEL=BAAI/bge-reranker-v2-m3

# --- Vector store ----------------------------------------------------------
# Local dev:    http://localhost:6333   (docker compose up -d qdrant)
# Qdrant Cloud: https://<cluster>.<region>.cloud.qdrant.io:6333
SCA_QDRANT_URL=http://localhost:6333
SCA_QDRANT_API_KEY=
SCA_COLLECTION=aaoifi_standards

# --- Retrieval tuning ------------------------------------------------------
SCA_RETRIEVE_CANDIDATES=40         # hybrid candidate pool before reranking
SCA_RERANK_TOP_K=5                 # clauses actually sent to the model
SCA_MAX_RETRIEVAL_ROUNDS=3         # hard cap on the agent's search loop

# --- Guardrail thresholds (escalate to NEEDS_REVIEW below these) -----------
SCA_MIN_RERANK_SCORE=0.35          # weakest top-1 clause we will reason over
SCA_MIN_MODEL_CONFIDENCE=0.70      # below this, escalate regardless of finding
SCA_MIN_CITATIONS=1                # a verdict with no citation is never returned

# --- Service ---------------------------------------------------------------
SCA_ENV=dev                        # dev | staging | prod
SCA_LOG_LEVEL=INFO
SCA_LOG_FULL_PROMPTS=true          # MUST be false in prod — see README security notes
SCA_JOB_TTL_SECONDS=3600

# --- Auth ------------------------------------------------------------------
# Demo-only static principals: "token:principal_id:scope1|scope2".
# Production replaces this with the bank's OIDC provider — see PART2 §5.
SCA_PRINCIPALS=demo-token-analyst:analyst@mal.ae:assess;demo-token-officer:officer@mal.ae:assess|review
