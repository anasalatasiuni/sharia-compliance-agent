.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
dist/
build/
*.egg-info/
corpus/raw/*
!corpus/raw/.gitkeep

# Qdrant now uses a named docker volume, but a bind-mount directory from an
# earlier run may still be on disk — and it is root-owned, so it is easy to
# stage by accident with `git add -A`.
qdrant_storage/
# Eval runs are evidence for the numbers in PART2 §3, so the ones the document
# quotes are committed; ad-hoc runs are not.
eval/results/*
!eval/results/20260915T0708*.json
!eval/results/20260915T0718*.json
!eval/results/20260915T1039*.json
!eval/results/20260915T1049*.json
logs/

# docs/ is a deliverable in this repo. A global ignore rule (**/docs/) excludes
# it, so re-include it explicitly. The directory itself has to be un-ignored
# first — git will not descend into an excluded directory to find negations.
!docs/
!docs/**
